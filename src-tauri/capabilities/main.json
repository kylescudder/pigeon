{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Privileged application window. Message viewers are deliberately absent: they get no capabilities at all.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-foundation-report",
    "allow-open-viewer-fixture",
    "allow-open-viewer-probe",
    "allow-quit-app",
    "allow-desktop-settings",
    "allow-set-desktop-settings",
    "allow-mail-state",
    "allow-add-mail-account",
    "allow-sync-mail-account",
    "allow-cancel-mail-sync",
    "allow-search-mail",
    "allow-cancel-mail-search",
    "allow-read-mail-message",
    "allow-save-mail-search",
    "allow-delete-mail-search",
    "allow-remove-mail-account",
    "allow-update-mail-password",
    "allow-unlock-mail",
    "allow-open-mail-message",
    "allow-backup-mail",
    "allow-restore-mail",
    "allow-queue-mail-actions",
    "allow-mail-actions",
    "allow-retry-mail-action",
    "allow-discard-mail-action",
    "allow-send-state",
    "allow-save-draft",
    "allow-delete-draft",
    "allow-send-draft",
    "allow-return-to-drafts",
    "allow-retry-send",
    "allow-retry-sent-copy",
    "allow-resolve-send",
    "allow-dismiss-outbox",
    "allow-update-mail-sending",
    "allow-set-undo-send-seconds"
  ]
}
